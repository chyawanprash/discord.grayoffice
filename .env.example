DISCORD_TOKEN=your-bot-token-here
# Optional: a test server ID for instant slash-command sync during development.
GUILD_ID=

# grayoffice backend the bot forwards messages to.
GRAYOFFICE_URL=http://localhost:5173
# Shared bearer token — must match BOT_INGEST_TOKEN in grayoffice's .dev.vars.
BOT_INGEST_TOKEN=dev-bot-ingest-token-change-me
